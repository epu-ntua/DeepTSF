# Keycloak deployment (docker-compose-keycloak.yml). Copy to .env and fill in.
# See "Deployment with Keycloak authentication" in the top-level README.

# ---------------------------------------------------------------------------
# Docker: names, network, resources (defaults shown; uncomment to change)
# ---------------------------------------------------------------------------
# COMPOSE_NETWORK=keycloak_net          # external network shared with the reverse proxy and ../oauth2proxy
# BACKEND_CONTAINER=DeepTSF-backend     # container name / DNS alias the reverse proxy forwards to
# DAGSTER_CONTAINER=DeepTSF--dagster-orchestrator
# DAGSTER_HOSTNAME=dagster              # must match DAGSTER_HOSTNAME in ../oauth2proxy/.env
# CHRONOS_CONTAINER=DeepTSF-chronos
# CHRONOS_HOSTNAME=chronos              # the reverse proxy forwards the Chronos-2 host to <this>:8000
# DOCKER_RUNTIME=runc                   # nvidia to give the worker and dagster the GPUs
# REDIS_CONTAINER=deeptsf-celery-redis  # only used by docker-compose-dagster-celery.yml
# WORKER_CONTAINER=deeptsf-celery-worker # only used by docker-compose-dagster-celery.yml
# DEEPTSF_BASE_IMAGE=deeptsf-base-keycloak:local
# BACKEND_MEM_LIMIT=
# WORKER_MEM_LIMIT=
DAGSTER_MEM_LIMIT=8g
# CHRONOS_MEM_LIMIT=8g

# Host ports, published on 127.0.0.1 only (the reverse proxy uses the docker network)
# Port the backend (uvicorn) listens on, inside the docker network and on the host
BACKEND_PORT=8081
# DAGSTER_PORT=8006
# CHRONOS_PORT=8010

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
USE_AUTH=keycloak
# Backend client (see "Keycloak clients" in the README)
KEYCLOAK_ID=<insert backend client id>
KEYCLOAK_SECRET=<insert backend client secret>
# https://<keycloak>/realms/<realm>/protocol/openid-connect/token
TOKEN_ISSUER_URL=<insert keycloak token url>
# Domain of the backend's session cookie, with a leading dot (e.g. .example.org)
host=.<insert domain>

# Dagster offline tokens. Only for an MLflow server with Keycloak login
# (mlflow-oidc-auth); leave all three empty for a plain MLflow server.
# Must be the same values as in ../oauth2proxy/.env.
KC_OFFLINE_ID=
KC_OFFLINE_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EG_TOKEN_ENC_KEY=
# EG_OFFLINE_TOKEN_DIR=/srv/eg-auth     # mount point of the eg_offline_tokens volume

# Extra browser origins the backend accepts, comma separated: your public
# dashboard and Dagster URLs, unless they are already in api.py's built-in list.
CORS_EXTRA_ORIGINS=https://<dashboard host>,https://<dagster public host>

# ---------------------------------------------------------------------------
# Dagster
# ---------------------------------------------------------------------------
# The public Dagster URL behind oauth2-proxy (not the dagster container): the
# backend launches the dashboard's runs through it.
DAGSTER_ENDPOINT_URL=https://<dagster public host>
# Dagster instance directory (dagster.yaml). The dagster image sets it itself,
# but the celery worker, which runs the dagster steps, gets it only from here.
DAGSTER_HOME=/app/dagster_deeptsf
# Not read by DeepTSF or Dagster (the dagster CLI only reads DAGSTER_CLI_* variables)
# DAGSTER_LOG_LEVEL=INFO
# Deployment-specific dagster storage (defaults set in the Dockerfiles):
# DAGSTER_PG_DATABASE=dagster_celery
# DAGSTER_COMPUTE_LOGS_PREFIX=dagster-compute-logs
# DAGSTER_IO_MANAGER_PREFIX=dagster-io-manager

# ---------------------------------------------------------------------------
# Redis / Celery (the redis service of docker-compose-keycloak.yml)
# ---------------------------------------------------------------------------
# REDIS_HOST=redis                      # must match the host in the URLs below and REDIS_HOST in ../oauth2proxy/.env
# Leave empty for no password; if set, use redis://:<password>@redis:6379/0 below
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------------------------------------------------------------------------
# MLflow and MinIO (existing servers, see "Choose an MLflow server" in the README)
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=<insert mlflow server url>
MLFLOW_S3_ENDPOINT_URL=<insert minio api url>
GIT_PYTHON_REFRESH=quiet
MINIO_CLIENT_URL=<insert minio host:port>
MINIO_SSL=true
MINIO_ACCESS_KEY=<insert minio user>
MINIO_SECRET_KEY=<insert minio pass>
AWS_ACCESS_KEY_ID=<insert minio user>
AWS_SECRET_ACCESS_KEY=<insert minio pass>
MINIO_PORT_API=9000
MINIO_PORT_UI=9001
MINIO_ROOT_USER=<insert minio root user>
MINIO_ROOT_PASSWORD=<insert minio root password>

# ---------------------------------------------------------------------------
# Postgres (dagster storage; existing server)
# ---------------------------------------------------------------------------
POSTGRES_USER=<insert postgres user>
POSTGRES_DATABASE=<insert postgres database>
POSTGRES_PASSWORD=<insert postgres password>
POSTGRES_HOST=<insert postgres host>

# ---------------------------------------------------------------------------
# Chronos-2 inference server (Foundation Models page of the dashboard)
# ---------------------------------------------------------------------------
# Exposed through the reverse proxy (e.g. https://deeptsf-chronos.<domain> ->
# ${CHRONOS_HOSTNAME}:8000). The dashboard uses CHRONOS_HOST=deeptsf-chronos.<domain>
# and the same token.
CHRONOS_IMAGE=deployaintua/chronos2-inference-server:1.0.0
# Required. Generate with: openssl rand -hex 32
CHRONOS_API_TOKEN=<insert chronos api token>
# Only if the amazon/chronos-2 weights are gated for your HuggingFace account
HF_TOKEN=

# ---------------------------------------------------------------------------
# MongoDB (only for the UC2 / UC6 / UC7 database integrations)
# ---------------------------------------------------------------------------
MONGO_USER=<mongo_user_name>
MONGO_PASS=<mongo_password>
MONGO_ADDRESS=<mongo_hostname>
MONGO_DB_NAME=<mongo_database_name>
MONGO_COLLECTION_UC7=<mongo_collection_name_uc7>
MONGO_COLLECTION_UC6=<mongo_collection_name_uc6>
MONGO_COLLECTION_UC2=<mongo_collection_name_uc2>
