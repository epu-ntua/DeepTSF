# Tracking server
## Postgres
POSTGRES_USER=postgres
POSTGRES_DATABASE=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=pgdb

## minio
AWS_ACCESS_KEY_ID=accessminio
AWS_SECRET_ACCESS_KEY=secretminio
MINIO_ROOT_USER=accessminio
MINIO_ROOT_PASSWORD=secretminio
# Buckets created by docker-compose.yml; these names are hardcoded in the code
MLFLOW_BUCKET_NAME=mlflow-bucket
DAGSTER_BUCKET_NAME=dagster-storage
DATASET_BUCKET_NAME=dataset-storage
MINIO_PORT=9000

# For use through docker (CLI and front-end)
MINIO_CLIENT_URL=s3:9000

# For use without docker (CLI with conda)
# MINIO_CLIENT_URL=localhost:9000

MINIO_SSL=false

# Back end
# Port the backend (uvicorn) listens on inside the docker network
BACKEND_PORT=8080

# For use through docker (CLI and front-end)
MLFLOW_TRACKING_URI=http://mlflow_server:5000
MLFLOW_S3_ENDPOINT_URL=http://s3:9000
DAGSTER_ENDPOINT_URL=http://deeptsf_dagster:8006
GIT_PYTHON_REFRESH=quiet

DAGSTER_HOME=/app/dagster_deeptsf
# Postgres database dagster keeps its runs/events/schedules in (dagster_deeptsf/dagster.yaml);
# created by the init-dagster-db service if missing.
DAGSTER_PG_DATABASE=dagster_celery
# Prefixes inside the dagster-storage bucket for step logs and step outputs
DAGSTER_COMPUTE_LOGS_PREFIX=dagster-compute-logs
DAGSTER_IO_MANAGER_PREFIX=dagster-io-manager

# Celery broker: used by the backend (CSV validation) and by dagster's celery executor
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# For use without docker (CLI with conda)
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
# DAGSTER_ENDPOINT_URL=http://localhost:8006
# GIT_PYTHON_REFRESH=quiet

# Front end (prebuilt image on Docker Hub, built with auth off and the
# localhost URLs: backend 8080, MLflow 5000, dagster 8006)
DASHBOARD_IMAGE=deployaintua/deeptsf-dashboard:local

# Chronos-2 inference server (Foundation Models page)
CHRONOS_IMAGE=deployaintua/chronos2-inference-server:1.0.0
# Empty = no auth on the Chronos-2 API; the dashboard's nginx sends it if set
CHRONOS_API_TOKEN=
# Only if the amazon/chronos-2 weights are gated for your HuggingFace account
HF_TOKEN=
# Host port for the Chronos-2 Swagger UI (debugging only)
CHRONOS_PORT=8010

# Security
USE_AUTH=False

# Host ports (docker-compose.yml): the localhost port each service is published
# on. Change one here if it clashes with something on your machine; the
# dashboard links and the backend CORS list follow automatically.
# BACKEND_PORT and CHRONOS_PORT above work the same way.
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
POSTGRES_HOST_PORT=5432
MLFLOW_HOST_PORT=5000
DASHBOARD_HOST_PORT=3000
DAGSTER_HOST_PORT=8006

# Extra browser origins the backend accepts (comma-separated), on top of the
# dashboard and Dagster localhost ports above, e.g. when you open the dashboard
# from another hostname.
# CORS_EXTRA_ORIGINS=http://my-host:3000
