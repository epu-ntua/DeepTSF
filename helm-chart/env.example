# Extra environment variables for the Kubernetes deploy (backend, dagster, worker).
# Everything not already passed with --set env.* in .gitlab-ci.yml goes here.
# In GitLab: Settings > CI/CD > Variables, add a variable of type "File" named
# DEEPTSF_ENV, scoped to the "stage" environment, with the contents of this file.
# Variables set with --set env.* win over the same name set here.

# Required only when USE_AUTH=keycloak (with USE_AUTH=jwt it is derived from `host`)
# DAGSTER_ENDPOINT_URL=https://deeptsf-dagster.stage.aiodp.ai

# Extra frontend origin(s) allowed by the backend's CORS, comma separated
# CORS_EXTRA_ORIGINS=

GIT_PYTHON_REFRESH=quiet

# Dagster storage (these are the image defaults; change only to separate deployments)
# DAGSTER_PG_DATABASE=dagster_celery
# DAGSTER_COMPUTE_LOGS_PREFIX=dagster-compute-logs
# DAGSTER_IO_MANAGER_PREFIX=dagster-io-manager

# MongoDB (use-case data loaders; leave out if unused)
# MONGO_URL=
# MONGO_USER=
# MONGO_PASS=
# MONGO_ADDRESS=
# MONGO_DB_NAME=
# MONGO_COLLECTION_UC2=
# MONGO_COLLECTION_UC6=
# MONGO_COLLECTION_UC7=

# Do NOT set KC_OFFLINE_ID / KC_OFFLINE_SECRET / EG_TOKEN_ENC_KEY here: they turn
# on the EnergyGuard gateway auth in dagster, which does not exist on Kubernetes.
# Do NOT change BACKEND_PORT: the Service targets 8081.
