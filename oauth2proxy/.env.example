# oauth2proxy stack in front of the Dagster UI. See "Start the oauth2proxy stack"
# in the top-level README.

# Public host name of the Dagster UI (no https://), e.g. deeptsf-dagster.example.org
DAGSTER_PUBLIC_HOST=<insert dagster public host>
# Domain the login cookie is valid for, e.g. .example.org
COOKIE_DOMAIN=<insert cookie domain>

# Keycloak realm URL: https://<keycloak>/realms/<realm>
KC_ISSUER_URL=<insert keycloak realm url>
# Dagster UI login client
KC_CLIENT_ID=<insert dagster client id>
KC_CLIENT_SECRET=<insert dagster client secret>
# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=<insert cookie secret>
# Extra token audience oauth2-proxy accepts besides KC_CLIENT_ID (default account)
# OAUTH2_EXTRA_AUDIENCE=account
# Host port oauth2-proxy is published on, localhost only (default 4180)
# OAUTH2_PROXY_HOST_PORT=4180

# Must match ../deeptsf_backend/.env (defaults of docker-compose-keycloak.yml)
DAGSTER_HOSTNAME=dagster
REDIS_HOST=redis
REDIS_PASSWORD=

# Dagster offline tokens. Only for an MLflow server with Keycloak login
# (mlflow-oidc-auth); leave all three empty for a plain MLflow server.
# Must be the same values as in ../deeptsf_backend/.env.
KC_OFFLINE_ID=
KC_OFFLINE_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EG_TOKEN_ENC_KEY=
